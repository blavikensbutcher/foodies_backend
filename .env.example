# Used by the app (Prisma) to connect to Postgres.
# For local docker-compose db, match host/port/user/password/db below.
DATABASE_URL="postgresql://foodies:foodies@localhost:55432/foodies?schema=public"

APP_URL=http://localhost
PORT=3000

# Used by docker-compose.yml to configure the local Postgres container
POSTGRES_USER=foodies
POSTGRES_PASSWORD=foodies
POSTGRES_DB=foodies
POSTGRES_PORT=55432

JWT_SECRET="change-me"
ACCESS_TOKEN_DURATION_MINUTES=15
REFRESH_TOKEN_DURATION_DAYS=7

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional, used by `npm run prisma:seed`. Lets you log in as the seeded
# users while developing. Leave it unset and they get an unguessable
# password, so seeding a shared database creates no usable accounts.
# SEED_USER_PASSWORD="password123"
